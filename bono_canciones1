/* Acceso directo a YouTube, sin reproductor incrustado. */
.youtube-block{background:#F1F5FC;border:1px solid #DBE5F3;border-radius:16px;padding:20px;margin-bottom:24px}
.youtube-block h3{font-size:15px;margin:0 0 8px;color:var(--blue)}
.youtube-block p{font-size:11px;line-height:1.7;color:#536782;margin:11px 0 0}
.yt-logo{display:block;width:27px;height:20px;flex-shrink:0}
.btn-youtube{background:#fff;color:#b51321;border:1px solid #e0b5b9;box-shadow:0 4px 14px rgba(181,19,33,.07)}
.btn-youtube:hover{background:#fff4f4}
.youtube-block .btn-youtube{font-size:14px;padding:14px 20px}
/* Enlaces a fuentes externas: video y letra. */
.music-action-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.music-action-row .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px}
.btn-lyrics{background:#eaf1fe;border:1px solid #b7caea;color:var(--blue);font-weight:700}
.btn-lyrics:hover{background:#dbe9ff;border-color:#799dd7;transform:translateY(-2px)}
.lyric-icon{width:19px;height:19px;flex-shrink:0}

.card-buttons{display:flex;flex-wrap:wrap;gap:7px;width:100%}
.card-buttons .btn{font-size:10px;padding:9px 11px}
@media(max-width:660px){.youtube-block{padding:15px}.card-buttons .btn{font-size:9px;padding:8px 9px}.card-buttons .yt-logo{width:21px;height:16px}.card-buttons .lyric-icon{width:16px;height:16px}.music-action-row .btn{width:100%}}

/* Invitaciones a practicar: enlaces simples, independientes de JavaScript */
