function persist(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state));return true}catch(_){return false}}
function notify(msg){$('toast').textContent=msg;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),2400)}
function getFiltered(){let result=SONGS.filter(s=>{const hay=strip([s.title,s.artist,s.country,s.topics].join(' '));return (!filters.q||hay.includes(strip(filters.q)))&&(filters.country==='all'||strip(s.country).includes(strip(filters.country)))&&matchesTopic(s,filters.topic)&&(filters.status==='all'||filters.status==='done'&&state.done.includes(s.id)||filters.status==='pending'&&!state.done.includes(s.id)||filters.status==='favorites'&&state.favorites.includes(s.id))}); if(filters.sort==='az')result.sort((a,b)=>a.title.localeCompare(b.title,'es'));if(filters.sort==='artist')result.sort((a,b)=>a.artist.localeCompare(b.artist,'es'));return result}
function updateStats(){const done=state.done.filter(x=>SONGS.some(s=>s.id===x)).length,fav=state.favorites.filter(x=>SONGS.some(s=>s.id===x)).length,percent=Math.round(100*done/SONGS.length);$('done-stat').textContent=done;$('fav-stat').textContent=fav;$('top-progress').textContent=`${done}/${SONGS.length} ✓`;$('progress-percent').textContent=percent+'%';$('progress-fill').style.width=percent+'%';$('progress-track').setAttribute('aria-valuenow',done)}
function card(s){const isDone=state.done.includes(s.id),fav=state.favorites.includes(s.id);return `<article class="song-card"><div class="cover"><div class="cover-pattern"></div><span class="tracknum">N.º ${String(s.id).padStart(2,'0')}</span><div class="disc" aria-hidden="true"></div><span class="country-tag">${escaped(s.country)}</span><button type="button" class="favbtn ${fav?'on':''}" data-favorite="${s.id}" aria-label="${fav?'Quitar de favoritas':'Añadir a favoritas'}: ${escaped(s.title)}" aria-pressed="${fav}">${fav?'♥':'♡'}</button></div><div class="card-body"><h3 class="card-title">${escaped(s.title)}</h3><p class="card-artist">${escaped(s.artist)}</p><div class="topic-label">Recursos lingüísticos</div><p class="topics-preview">${escaped(s.topics)}</p><div class="card-bottom"><span class="status ${isDone?'done':''}"><span class="status-dot"></span>${isDone?'Practicada':'Por descubrir'}</span><div class="card-buttons"><a class="btn btn-youtube" href="${youtubeUrl(s)}" target="_blank" rel="noopener noreferrer" aria-label="Escuchar ${escaped(s.title)} de ${escaped(s.artist)} en YouTube">${YT_SVG} YouTube</a><a class="btn btn-lyrics" href="${escaped(s.lyricsUrl)}" target="_blank" rel="noopener noreferrer" aria-label="Ver la letra de ${escaped(s.title)} de ${escaped(s.artist)} en una página externa">${LYRICS_SVG} Ver la letra</a><button type="button" class="btn btn-soft" data-open="${s.id}">Ver ficha y practicar</button></div></div></div></article>`}
function render(){const list=getFiltered();$('song-grid').innerHTML=list.map(card).join('');$('empty').classList.toggle('hidden',list.length>0);$('results-count').textContent=`${list.length} de ${SONGS.length} canciones`;updateStats();document.querySelectorAll('#theme-chips .chip').forEach(c=>{const active=c.dataset.topic===filters.topic;c.classList.toggle('active',active);c.setAttribute('aria-pressed',String(active))})}
function resetFilters(){filters={q:'',country:'all',status:'all',topic:'all',sort:'original'};$('search').value='';$('country').value='all';$('status').value='all';$('sort').value='original';render()}
function toggleFavorite(id){const p=state.favorites.indexOf(id);p<0?state.favorites.push(id):state.favorites.splice(p,1);persist();render();if(current?.id===id)syncModalButtons();notify(p<0?'Guardada en favoritas ♥':'Eliminada de favoritas')}
function toggleComplete(id){const p=state.done.indexOf(id);p<0?state.done.push(id):state.done.splice(p,1);persist();render();syncModalButtons();notify(p<0?'¡Canción marcada como practicada!':'Marcada como pendiente')}
function syncModalButtons(){if(!current)return;const liked=state.favorites.includes(current.id),done=state.done.includes(current.id);$('modal-favorite').textContent=liked?'♥ Favorita':'♡ Favorita';$('modal-favorite').setAttribute('aria-pressed',String(liked));$('toggle-complete').textContent=done?'✓ Ya practicada · desmarcar':'✓ Marcar como practicada';$('toggle-complete').classList.toggle('done',done)}
function openSong(id){
 const s=SONGS.find(s=>s.id===id);if(!s)return;
 previouslyFocused=document.activeElement;current=s;
 $('modal-number').textContent=`CANCIÓN ${String(s.id).padStart(2,'0')} · ${s.country.toUpperCase()}`;
 $('modal-title').textContent=s.title;$('modal-sub').textContent=s.artist;
 $('modal-topics').textContent=s.topics;
 $('before-prompt').textContent=`Lee el título «${s.title}». ¿Qué te sugiere? Imagina dos ideas sobre su mensaje antes de escucharla.`;
 $('during-prompt').textContent='Abre YouTube y escucha atentamente. Identifica ejemplos de los recursos lingüísticos de la ficha. No necesitas entender cada palabra.';
 $('after-prompt').textContent='Explica con tus palabras una idea de la canción, da tu opinión y utiliza una expresión reconocida.';
 $('notes').value=String(state.notes[s.id]||'');
 $('save-status').textContent='Las notas se guardan en este navegador cuando el almacenamiento está disponible.';
 $('youtube-link').href=youtubeUrl(s);
 $('youtube-link').setAttribute('aria-label',`Escuchar ${s.title} de ${s.artist} en YouTube`);
 $('lyrics-link').href=s.lyricsUrl;
 $('lyrics-link').setAttribute('aria-label',`Ver la letra de ${s.title} de ${s.artist} en una página externa`);
 syncModalButtons();
 $('overlay').classList.remove('hidden');document.body.style.overflow='hidden';$('close-modal').focus();
}
function closeSong(){
 $('overlay').classList.add('hidden');document.body.style.overflow='';current=null;
 if(previouslyFocused&&previouslyFocused.isConnected)previouslyFocused.focus();previouslyFocused=null;
}
function pickRandom(){const pool=getFiltered();if(!pool.length){notify('No hay canciones con esos filtros.');return}openSong(pool[Math.floor(Math.random()*pool.length)].id)}
function exportNotes(){const lines=['MI DIARIO MUSICAL · SPANISH AT WORK','La Oficina en Español','',`Progreso: ${state.done.length} de ${SONGS.length} canciones`,'','-------------------------------------',''];SONGS.forEach(s=>{const done=state.done.includes(s.id),fav=state.favorites.includes(s.id),note=String(state.notes[s.id]||'').trim();if(done||fav||note){lines.push(`${s.id}. ${s.title} — ${s.artist}`);lines.push(`País: ${s.country}`);lines.push(`Practicada: ${done?'sí':'no'} · Favorita: ${fav?'sí':'no'}`);lines.push(`Notas: ${note||'(sin notas)'}`,'')}});if(lines.length<9)lines.push('Todavía no has guardado ninguna práctica.');const blob=new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='mi-diario-musical-spanish-at-work.txt';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);notify('Diario descargado')}
for(const country of [...new Set(SONGS.flatMap(s=>s.country.split('/').map(c=>c.trim())))].sort((a,b)=>a.localeCompare(b,'es'))){const opt=document.createElement('option');opt.value=country;opt.textContent=country;$('country').appendChild(opt)}
$('theme-chips').insertAdjacentHTML('beforeend',TOPICS.map(([k,label])=>`<button type="button" class="chip ${k==='all'?'active':''}" data-topic="${k}" aria-pressed="${k==='all'}">${escaped(label)}</button>`).join(''));
$('theme-chips').addEventListener('click',e=>{const b=e.target.closest('[data-topic]');if(!b)return;filters.topic=b.dataset.topic;render()});
$('search').addEventListener('input',e=>{filters.q=e.target.value;render()});$('country').addEventListener('change',e=>{filters.country=e.target.value;render()});$('status').addEventListener('change',e=>{filters.status=e.target.value;render()});$('sort').addEventListener('change',e=>{filters.sort=e.target.value;render()});
$('song-grid').addEventListener('click',e=>{const fav=e.target.closest('[data-favorite]');if(fav){toggleFavorite(Number(fav.dataset.favorite));return}const item=e.target.closest('[data-open]');if(item)openSong(Number(item.dataset.open))});
$('surprise').addEventListener('click',pickRandom);$('random-hero').addEventListener('click',pickRandom);$('clear-filters').addEventListener('click',resetFilters);$('close-modal').addEventListener('click',closeSong);$('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))closeSong()});document.addEventListener('keydown',e=>{if(!current)return;if(e.key==='Escape'){e.preventDefault();closeSong();return}if(e.key==='Tab'){const focusable=[...$('song-modal').querySelectorAll('a[href],button:not([disabled]),textarea,input,select,[tabindex]:not([tabindex="-1"])')].filter(el=>el.getClientRects().length);if(!focusable.length)return;const first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});$('modal-favorite').addEventListener('click',()=>current&&toggleFavorite(current.id));$('toggle-complete').addEventListener('click',()=>current&&toggleComplete(current.id));
$('notes').addEventListener('input',e=>{if(!current)return;state.notes[current.id]=e.target.value;const saved=persist();$('save-status').textContent=saved?'Guardado ✓':'No se pudo guardar: almacenamiento del navegador no disponible.'});
$('export-notes').addEventListener('click',exportNotes);$('reset-data').addEventListener('click',()=>{if(!confirm('¿Quieres borrar tus favoritos, notas y canciones practicadas en este navegador?'))return;state=defaults();persist();render();notify('Avance reiniciado')});
render();
</script>
</body>
</html>
